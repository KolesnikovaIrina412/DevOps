# Скопировать этот файл в .env и заполнить своими значениями:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)

# Секретный ключ для сессий и CSRF — обязательно заменить на свой
# Сгенерировать можно так: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Максимальный размер загружаемого файла в байтах (по умолчанию 16 МБ)
MAX_CONTENT_LENGTH=16777216

# Режим отладки: 1 — включён, 0 — выключен
FLASK_DEBUG=1